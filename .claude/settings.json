{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$CLAUDE_PROJECT_DIR/.claude/scripts/stop-check.sh\"",
            "timeout": 60000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$CLAUDE_PROJECT_DIR/.claude/scripts/post-edit-lint.sh\"",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "zsh \"$CLAUDE_PROJECT_DIR/.claude/scripts/post-edit-lint.sh\"",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
