{
  "name": "nepp-chan",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "server:dev": "pnpm --filter @nepp-chan/server dev",
    "server:deploy:dev": "pnpm --filter @nepp-chan/server run deploy",
    "server:deploy:prd": "pnpm --filter @nepp-chan/server run deploy:prd",
    "web:dev": "pnpm --filter @nepp-chan/web dev",
    "web:build": "pnpm --filter @nepp-chan/web build",
    "web:deploy:dev": "pnpm --filter @nepp-chan/web run deploy",
    "web:deploy:prd": "pnpm --filter @nepp-chan/web run deploy:prd",
    "mastra:dev": "pnpm --filter @nepp-chan/server mastra:dev",
    "mastra:build": "pnpm --filter @nepp-chan/server mastra:build",
    "mastra:start": "pnpm --filter @nepp-chan/server mastra:start",
    "lint": "biome check . && pnpm --filter @nepp-chan/web check && pnpm --filter @nepp-chan/server exec tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @nepp-chan/server db:generate",
    "db:migrate:dev": "pnpm --filter @nepp-chan/server db:migrate:dev",
    "db:migrate:prd": "pnpm --filter @nepp-chan/server db:migrate:prd",
    "db:migrate:local": "pnpm --filter @nepp-chan/server db:migrate:local",
    "db:studio": "pnpm --filter @nepp-chan/server db:studio",
    "db:studio:dev": "pnpm --filter @nepp-chan/server db:studio:dev",
    "db:studio:prd": "pnpm --filter @nepp-chan/server db:studio:prd",
    "db:push": "pnpm --filter @nepp-chan/server db:push",
    "db:check": "pnpm --filter @nepp-chan/server db:check",
    "knowledge:upload:local": "tsx --env-file=.env.local .claude/skills/np-knowledge/scripts/upload-knowledge.ts",
    "knowledge:upload:dev": "tsx --env-file=.env.development .claude/skills/np-knowledge/scripts/upload-knowledge.ts",
    "knowledge:upload:prd": "tsx --env-file=.env.production .claude/skills/np-knowledge/scripts/upload-knowledge.ts",
    "test": "pnpm --filter @nepp-chan/server test",
    "admin:invite:local": "tsx server/scripts/create-invitation.ts",
    "admin:invite:dev": "tsx server/scripts/create-invitation.ts --env=dev",
    "admin:invite:prd": "tsx server/scripts/create-invitation.ts --env=prd",
    "eval:v2": "pnpm --filter @nepp-chan/server eval:v2",
    "eval:v3": "pnpm --filter @nepp-chan/server eval:v3",
    "api:quota": "pnpm --filter @nepp-chan/server api:quota",
    "frontmatter:add": "tsx .claude/skills/np-knowledge/scripts/add-frontmatter.ts",
    "frontmatter:extract": "tsx --env-file=server/.dev.vars .claude/skills/np-knowledge/scripts/extract-date-contact.ts --target=dataset",
    "frontmatter:apply": "tsx .claude/skills/np-knowledge/scripts/apply-date-contact.ts",
    "openapi:generate": "pnpm --filter @nepp-chan/web openapi:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "tsx": "^4.21.0",
    "wrangler": "^4.76.0"
  }
}
