{
  "name": "nepp-chan",
  "version": "1.0.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "server:dev": "pnpm --filter @nepp-chan/server dev",
    "server:deploy:dev": "pnpm --filter @nepp-chan/server run deploy",
    "server:deploy:prd": "pnpm --filter @nepp-chan/server run deploy:prd",
    "web:dev": "pnpm --filter @nepp-chan/web dev",
    "web:build": "pnpm --filter @nepp-chan/web build",
    "web:deploy:dev": "pnpm --filter @nepp-chan/web run deploy",
    "web:deploy:prd": "pnpm --filter @nepp-chan/web run deploy:prd",
    "lp:dev": "pnpm --filter @nepp-chan/lp dev",
    "lp:build": "pnpm --filter @nepp-chan/lp build",
    "lp:deploy:dev": "pnpm --filter @nepp-chan/lp run deploy",
    "lp:deploy:prd": "pnpm --filter @nepp-chan/lp run deploy:prd",
    "mastra:dev": "pnpm --filter @nepp-chan/server mastra:dev",
    "mastra:build": "pnpm --filter @nepp-chan/server mastra:build",
    "mastra:start": "pnpm --filter @nepp-chan/server mastra:start",
    "lint": "biome check . && pnpm --filter @nepp-chan/web check && pnpm --filter @nepp-chan/lp check && pnpm --filter @nepp-chan/widget check && pnpm --filter @nepp-chan/server exec tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @nepp-chan/server db:generate",
    "db:migrate:dev": "pnpm --filter @nepp-chan/server db:migrate:dev",
    "db:migrate:prd": "pnpm --filter @nepp-chan/server db:migrate:prd",
    "db:migrate:local": "pnpm --filter @nepp-chan/server db:migrate:local",
    "db:check": "pnpm --filter @nepp-chan/server db:check",
    "knowledge:upload:local": "tsx scripts/upload-knowledge.ts --env=local",
    "knowledge:upload:dev": "tsx scripts/upload-knowledge.ts --env=dev",
    "knowledge:upload:prd": "tsx scripts/upload-knowledge.ts --env=prd",
    "test": "pnpm --filter @nepp-chan/server test && pnpm --filter @nepp-chan/shared test && pnpm --filter @nepp-chan/web test && pnpm --filter @nepp-chan/widget test",
    "test:cov": "pnpm --filter @nepp-chan/server test:cov && pnpm --filter @nepp-chan/shared test:cov && pnpm --filter @nepp-chan/web test:cov && pnpm --filter @nepp-chan/widget test:cov",
    "shared:test": "pnpm --filter @nepp-chan/shared test",
    "shared:test:cov": "pnpm --filter @nepp-chan/shared test:cov",
    "web:test": "pnpm --filter @nepp-chan/web test",
    "web:test:cov": "pnpm --filter @nepp-chan/web test:cov",
    "admin:invite:local": "tsx server/scripts/create-invitation.ts",
    "admin:invite:dev": "tsx server/scripts/create-invitation.ts --env=dev",
    "admin:invite:prd": "tsx server/scripts/create-invitation.ts --env=prd",
    "eval:v2": "pnpm --filter @nepp-chan/server eval:v2",
    "eval:v3": "pnpm --filter @nepp-chan/server eval:v3",
    "api:quota": "pnpm --filter @nepp-chan/server api:quota",
    "frontmatter:add": "tsx scripts/add-frontmatter.ts",
    "frontmatter:extract": "tsx --env-file=server/.dev.vars scripts/extract-date-contact.ts --target=dataset",
    "frontmatter:apply": "tsx scripts/apply-date-contact.ts",
    "openapi:generate": "pnpm --filter @nepp-chan/web openapi:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "tsx": "^4.23.13",
    "wrangler": "^4.123.0"
  }
}
