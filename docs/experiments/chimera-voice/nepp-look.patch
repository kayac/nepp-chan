+/** ブラウザ内の形態素解析（OpenJTalk の wasm）。辞書は初回の解析時に読み込む。 */
+import type { NjdNode } from "./japanese.ts";
+
+const DIC_URL = "/ojt/assets/dic";
+// 音声合成は使わないが、解析器の初期化に音声ファイルの指定が要る
+const VOICE_URL = "/ojt/assets/voice.htsvoice";
+
+type Frontend = (text: string) => Promise<NjdNode[]>;
+let frontend: Promise<Frontend> | null = null;
+
+async function load(): Promise<Frontend> {
+  // モジュールの読み込み時に Worker が起動するので、使うときまで import しない
+  const ojt = await import("@keanu-thakalath/openjtalkjs/browser");
+  await ojt.configure({ dicUrl: DIC_URL, voiceUrl: VOICE_URL });
+  return ojt.runFrontendAsync;
+}
+
+export function analyzeJapanese(text: string): Promise<NjdNode[]> {
+  frontend ??= load().catch((error) => {
+    frontend = null;
+    throw error;
+  });
+  return frontend.then((run) => run(text));
+}
