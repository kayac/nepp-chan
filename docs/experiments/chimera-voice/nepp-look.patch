@@ -0,0 +1,46 @@
+/**
+ * 文を届いた順に 1 つずつ喋らせる列。エンジンは新しい発話の予約で前の発話を上書きするので、
+ * 前の文が終わるまで次の文の予約を待つ。
+ */
+
+/** 文と文のあいだの間（秒） */
+const GAP_SEC = 0.22;
+
+export class SpeechQueue {
+  private generation = 0;
+  private tail: Promise<void> = Promise.resolve();
+
+  /**
+   * @param speak 文を喋らせ、その長さ（秒）を返す。喋るものがなければ null
+   * @param stop いま喋っている発話を止める
+   */
+  constructor(
+    private readonly speak: (text: string) => Promise<number | null>,
+    private readonly stop: () => void,
+    private readonly wait: (seconds: number) => Promise<void> = (seconds) => new Promise((resolve) => setTimeout(resolve, seconds * 1000)),
+  ) {}
+
+  enqueue(text: string): Promise<void> {
+    const generation = this.generation;
+    this.tail = this.tail.then(async () => {
+      if (generation !== this.generation) return;
+      let duration: number | null;
+      try {
+        duration = await this.speak(text);
+      } catch (cause) {
+        // 1 文の失敗で残りの文まで黙らせない
+        console.error(cause);
+        return;
+      }
+      if (duration === null || generation !== this.generation) return;
+      await this.wait(duration + GAP_SEC);
+    });
+    return this.tail;
+  }
+
+  /** 待っている文を捨て、喋っている途中の文も止める */
+  clear(): void {
+    this.generation += 1;
+    this.stop();
+  }
+}
