new file mode 100644
index 0000000..156069f
--- /dev/null
+++ b/src/ui/neppChat.ts
@@ -0,0 +1,142 @@
+/** ローカルで動かした nepp-chan の API と話す。Vite の proxy 越しに同一オリジンで呼ぶ。 */
+
+const API_BASE = "/nepp-api";
+
+/** 返答ストリーム（SSE）の断片を受け取り、本文の差分だけを取り出す */
+export function createDeltaParser(): (chunk: string) => string[] {
+  let buffer = "";
+  return (chunk) => {
+    buffer += chunk;
+    const lines = buffer.split("\n");
+    buffer = lines.pop() ?? "";
+    const deltas: string[] = [];
+    for (const line of lines) {
+      if (!line.startsWith("data:")) continue;
+      const payload = line.slice(5).trim();
+      if (payload === "" || payload === "[DONE]") continue;
+      let event: { type?: unknown; delta?: unknown };
+      try {
+        event = JSON.parse(payload);
+      } catch {
+        // 行の途中で切れた断片は buffer に残るので、ここに来るのは壊れた行だけ
+        continue;
+      }
+      if (event.type === "text-delta" && typeof event.delta === "string") deltas.push(event.delta);
+    }
+    return deltas;
+  };
+}
+
+// 閉じ括弧が続く記号は引用の中（「食べてみたい！」ってなる…）なので、文の終わりにしない
+const SENTENCE_END = /[。！？!?]+(?![。！？!?」』）)])|\n+/;
+
+/** 返答の差分を受け取り、言い終わった文から順に取り出す。flush は言いかけの残りを返す */
+export function createSentenceSplitter(): { push: (delta: string) => string[]; flush: () => string | null } {
+  let buffer = "";
+  return {
+    push(delta) {
+      buffer += delta;
+      const sentences: string[] = [];
+      for (;;) {
+        const match = SENTENCE_END.exec(buffer);
+        // 終わりの記号がバッファの末尾にあるうちは、続きの記号や閉じ括弧が届くかもしれない
+        if (!match || match.index + match[0].length === buffer.length) break;
+        const sentence = buffer.slice(0, match.index + match[0].length).trim();
+        buffer = buffer.slice(match.index + match[0].length);
+        if (sentence) sentences.push(sentence);
+      }
+      return sentences;
+    },
+    flush() {
+      const rest = buffer.trim();
+      buffer = "";
+      return rest || null;
+    },
+  };
+}
+
+const MARKDOWN_LINK = /\[([^\]]+)\]\([^)]*\)/g;
+const URL = /https?:\/\/\S+/g;
+const EMOJI_RUN = /[\p{Extended_Pictographic}\uFE0F\u200D]+/gu;
+const LINE_BREAKS = /\s*\n+\s*/g;
+const EDGE_PAUSES = /^[、\s]+|[、\s]+$/g;
+const SPOKEN_MARKUP = /~~|[*#`]/g;
+const PHONE = /(?<!\d)(\d{2,5})-(\d{1,4})-(\d{3,4})(?!\d)/g;
+const TIME = /(?<!\d)(\d{1,2})[:：](\d{2})(?!\d)/g;
+const RANGE = /[~〜～]\s*(?=\d)/g;
+const TIME_RANGE = /([時分])\s*[-－]\s*(?=\d)/g;
+const WEEKDAY_RANGE = /([月火水木金土日](?:曜日?)?)\s*[~〜～]\s*(?=[月火水木金土日])/g;
+const WAVE_DASH = /[~〜～]/g;
+
+/** 画面に出す返答から、声に出す文面を作る（規則は nepp-chan の音声通話用の整形に合わせている） */
+export function speechTextOf(reply: string): string {
+  return reply
+    .replace(MARKDOWN_LINK, "$1")
+    .replace(URL, "")
+    // 絵文字と改行は文の切れ目として書かれていることが多いので、息継ぎに置き換える
+    .replace(EMOJI_RUN, "、")
+    .replace(LINE_BREAKS, "。")
+    .replace(SPOKEN_MARKUP, "")
+    .replace(PHONE, "$1の$2の$3")
+    .replace(TIME, (_, hour: string, minute: string) => `${Number(hour)}時${minute === "00" ? "" : `${Number(minute)}分`}`)
+    .replace(RANGE, "から")
+    .replace(TIME_RANGE, "$1から")
+    .replace(WEEKDAY_RANGE, "$1から")
+    .replace(WAVE_DASH, "ー")
+    .replace(EDGE_PAUSES, "");
+}
+
+interface Session {
+  token: string;
+  threadId: string;
+}
+
+async function postJson(path: string, body: unknown, token?: string): Promise<Response> {
+  const response = await fetch(`${API_BASE}${path}`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+    body: JSON.stringify(body),
+  });
+  if (!response.ok) throw new Error(`nepp-chan API ${path} が ${response.status} を返しました`);
+  return response;
+}
+
+async function openSession(): Promise<Session> {
+  const { token } = (await (await postJson("/auth/anonymous-session", {})).json()) as { token: string };
+  const { id } = (await (await postJson("/threads", {}, token)).json()) as { id: string };
+  return { token, threadId: id };
+}
+
+export class NeppChat {
+  private session: Promise<Session> | null = null;
+
+  /** 質問を送り、返答の全文を返す。途中経過は onProgress に、言い終わった文は順に onSentence に渡す */
+  async send(text: string, on: { progress: (replySoFar: string) => void; sentence: (sentence: string) => void }): Promise<string> {
+    this.session ??= openSession();
+    let session: Session;
+    try {
+      session = await this.session;
+    } catch (error) {
+      this.session = null;
+      throw error;
+    }
+    const response = await postJson(`/threads/${session.threadId}/chat`, { message: { id: crypto.randomUUID(), role: "user", parts: [{ type: "text", text }] } }, session.token);
+    if (!response.body) throw new Error("nepp-chan API の返答に本文がありません");
+    const reader = response.body.pipeThrough(new TextDecoderStream()).getReader();
+    const parse = createDeltaParser();
+    const splitter = createSentenceSplitter();
+    let reply = "";
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      for (const delta of parse(value)) {
+        reply += delta;
+        for (const sentence of splitter.push(delta)) on.sentence(sentence);
+      }
+      on.progress(reply);
+    }
+    const rest = splitter.flush();
+    if (rest) on.sentence(rest);
+    return reply;
+  }
+}
