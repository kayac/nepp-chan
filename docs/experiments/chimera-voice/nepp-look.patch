diff --git a/tests/japanese.test.ts b/tests/japanese.test.ts
new file mode 100644
index 0000000..88677d8
--- /dev/null
+++ b/tests/japanese.test.ts
@@ -0,0 +1,244 @@
+import { describe, expect, test } from "bun:test";
+import { initEngine } from "./harness.ts";
+
+await initEngine();
+const { planPhrases } = await import("../src/wasm/engine.ts");
+const { adaptVoicingForJapanese, containsJapanese, containsKana, isKanaNotation, itemsToPhrases, japanesePhrases, japaneseSyllables, njdToItems, parseAccentPhrase, properNounItem, splitProperNouns } = await import("../src/ui/japanese.ts");
+
+const BASE_F0 = 200;
+const ipaOf = (text: string) => japanesePhrases(text, BASE_F0).map((p) => p.segments.map((s) => s.ipa).join(" "));
+const pitched = (text: string) => japanesePhrases(text, BASE_F0)[0].segments.filter((s) => s.f0 !== undefined);
+const totalDur = (text: string) => japanesePhrases(text, BASE_F0)[0].segments.reduce((sum, s) => sum + (s.dur ?? 0), 0);
+
+describe("かなの判定", () => {
+  test("ひらがな・カタカナを含めば日本語として扱う", () => {
+    expect(containsKana("こんにちわ")).toBe(true);
+    expect(containsKana("ネップ")).toBe(true);
+  });
+  test("英文と IPA は日本語として扱わない", () => {
+    expect(containsKana("Hello. Can you hear me?")).toBe(false);
+    expect(containsKana("ˈhɛloʊ")).toBe(false);
+  });
+});
+
+describe("かな → 音素", () => {
+  test("撥音は次の子音の位置に同化する", () => {
+    expect(ipaOf("こんにちわ")).toEqual(["k o ɲ ɲ i tʃ i w a"]);
+    expect(ipaOf("さんぽ")).toEqual(["s a m p o"]);
+    expect(ipaOf("ほん")).toEqual(["h o ɴ"]);
+  });
+  test("拗音は 1 モーラにまとまる", () => {
+    expect(parseAccentPhrase("ちゃ").moras).toHaveLength(1);
+    expect(ipaOf("きょ")).toEqual(["k j o"]);
+  });
+  test("カタカナはひらがなと同じ音になる", () => {
+    expect(ipaOf("ネップ")).toEqual(ipaOf("ねっぷ"));
+  });
+  test("お段 + う と長音記号は同じ長音になる", () => {
+    expect(ipaOf("ようこそ")).toEqual(ipaOf("よーこそ"));
+    expect(ipaOf("よーこそ")).toEqual(["j o o k o s o"]);
+  });
+  test("句読点で息継ぎ句に分かれる", () => {
+    expect(ipaOf("こんにちわ。ねっぷ")).toHaveLength(2);
+  });
+  test("かな以外だけの入力は句を作らない", () => {
+    expect(japanesePhrases("。 、", BASE_F0)).toEqual([]);
+  });
+});
+
+describe("モーラの長さ", () => {
+  test("モーラ数が同じなら子音が違っても全長は同じ", () => {
+    expect(totalDur("あさ")).toBeCloseTo(totalDur("かた"), 6);
+  });
+  test("促音は次の子音を 1 モーラぶん長くする", () => {
+    const plain = japanesePhrases("ねぷ", BASE_F0)[0].segments.find((s) => s.ipa === "p");
+    const geminate = japanesePhrases("ねっぷ", BASE_F0)[0].segments.find((s) => s.ipa === "p");
+    expect((geminate?.dur ?? 0) - (plain?.dur ?? 0)).toBeCloseTo(0.14, 6);
+  });
+  test("促音・撥音・長音も 1 モーラとして全長に数える", () => {
+    expect(totalDur("ねっぷ") - totalDur("ねぷ")).toBeCloseTo(0.14, 6);
+    expect(totalDur("ほん") - totalDur("ほ")).toBeCloseTo(0.14, 6);
+    expect(totalDur("よー") - totalDur("よ")).toBeCloseTo(0.14, 6);
+  });
+});
+
+describe("ピッチアクセント", () => {
+  test("核がなければ平板: 1 モーラ目が低く、2 モーラ目から高い", () => {
+    const [first, second] = pitched("さかな");
+    expect(first.f0!).toBeLessThan(second.f0!);
+  });
+  test("頭高: 1 モーラ目が高く、次から下がる", () => {
+    const [first, second] = pitched("ね'こ");
+    expect(first.f0!).toBeGreaterThan(second.f0!);
+  });
+  test("中高: 核のモーラまで高く、その次で下がる", () => {
+    const [mo1, mo2, mo3] = pitched("たま'ご");
+    expect(mo2.f0!).toBeGreaterThan(mo1.f0!);
+    expect(mo3.f0!).toBeLessThan(mo2.f0!);
+  });
+  test("疑問符で終わる句は最後のモーラが上がる", () => {
+    const statement = pitched("ね'こ").at(-1)!;
+    const question = pitched("ね'こ？").at(-1)!;
+    expect(question.f0!).toBeGreaterThan(statement.f0!);
+  });
+  test("どれだけ下がっても基準の 75% を下回らない", () => {
+    const phrases = japanesePhrases("あ'め あ'め あ'め あ'め あ'め あ'め", BASE_F0);
+    for (const s of phrases[0].segments) if (s.f0 !== undefined) expect(s.f0).toBeGreaterThanOrEqual(BASE_F0 * 0.75);
+  });
+});
+
+describe("無気化の後処理", () => {
+  const plan = planPhrases(japanesePhrases("かたさ", BASE_F0), { body: { female: 1, child: 0 }, t0: 0, rate: 1, f0: BASE_F0 });
+  const adapted = adaptVoicingForJapanese(plan.gestures, 1);
+  test("帯気ジェスチャは声門の開きが小さくなり、早く終わる", () => {
+    const before = plan.gestures.filter((g) => g.label === "aspiration");
+    const after = adapted.filter((g) => g.label === "aspiration");
+    expect(before.length).toBeGreaterThan(0);
+    after.forEach((g, i) => {
+      expect(g.targets.abduction).toBe(0.22);
+      expect(g.t1).toBeLessThan(before[i].t1);
+    });
+  });
+  test("摩擦音の声門開放は遅れて始まる", () => {
+    const before = plan.gestures.find((g) => g.label === "voiceless")!;
+    const after = adapted.find((g) => g.label === "voiceless")!;
+    expect(after.t0).toBeGreaterThan(before.t0);
+  });
+  test("それ以外のジェスチャは変えない", () => {
+    const untouched = (g: { label?: string }) => g.label !== "aspiration" && g.label !== "voiceless";
+    expect(adapted.filter(untouched)).toEqual(plan.gestures.filter(untouched));
+  });
+});
+
+const node = (string: string, pron: string, acc: number, chain_flag: number, pos = "名詞") => ({ string, pron, pos, acc, chain_flag });
+
+describe("入力の振り分け", () => {
+  test("漢字だけの文も日本語として扱う", () => {
+    expect(containsJapanese("今日")).toBe(true);
+    expect(containsJapanese("Hello")).toBe(false);
+  });
+  test("アクセント記号があり漢字がなければ手書き記法として読む", () => {
+    expect(isKanaNotation("ね'こ")).toBe(true);
+  });
+  test("記号がない、または漢字を含む文は解析に回す", () => {
+    expect(isKanaNotation("ねこ")).toBe(false);
+    expect(isKanaNotation("猫'だ")).toBe(false);
+  });
+});
+
+describe("固有語の切り出し", () => {
+  test("固有語は決めた読みつきで切り出し、前後は解析用に残す", () => {
+    expect(splitProperNouns("こんにちは！ねっぷちゃんだよ")).toEqual([{ text: "こんにちは！" }, { text: "ねっぷちゃん", reading: "ね'っぷちゃん" }, { text: "だよ" }]);
+  });
+  test("固有語がなければ全体を 1 つで返す", () => {
+    expect(splitProperNouns("いい天気")).toEqual([{ text: "いい天気" }]);
+  });
+  test("空の入力は何も返さない", () => {
+    expect(splitProperNouns("")).toEqual([]);
+  });
+  test("固有語の読みはアクセント核つきの発話単位になる", () => {
+    const item = properNounItem("ねっぷちゃん", "ね'っぷちゃん");
+    expect(item).toMatchObject({ kind: "unit", text: "ねっぷちゃん", accent: 1 });
+  });
+});
+
+describe("解析結果 → 発話単位", () => {
+  test("前の語に続く語は 1 つのアクセント句にまとまり、核は先頭の語の値を使う", () => {
+    const items = njdToItems([node("今日", "キョー", 1, 0), node("は", "ワ", 0, 1, "助詞")]);
+    expect(items).toHaveLength(1);
+    expect(items[0]).toMatchObject({ kind: "unit", text: "今日は", accent: 1 });
+    expect(items[0].kind === "unit" && items[0].moras).toHaveLength(3);
+  });
+  test("続かない語は別のアクセント句になる", () => {
+    expect(njdToItems([node("いい", "イイ", 1, 0), node("天気", "テンキ", 1, 0)])).toHaveLength(2);
+  });
+  test("記号は息継ぎになり、疑問符は語尾上げとして残る", () => {
+    const items = njdToItems([node("元気", "ゲンキ", 1, 0), node("？", "？", 0, 0, "記号"), node("はい", "ハイ", 1, 0), node("。", "、", 0, 0, "記号")]);
+    expect(items.map((i) => (i.kind === "break" ? i.question : i.text))).toEqual(["元気", true, "はい", false]);
+  });
+  test("無声化の印は読みから落とす", () => {
+    const items = njdToItems([node("です", "デス’", 1, 0, "助動詞")]);
+    expect(items[0]).toMatchObject({ accent: 1 });
+    expect(items[0].kind === "unit" && items[0].moras).toHaveLength(2);
+  });
+  test("解析器の読みでは、お段 + ウ を長音にしない（長音は「ー」で届く）", () => {
+    const items = njdToItems([node("思う", "オモウ", 2, 0, "動詞")]);
+    const phrase = itemsToPhrases(items, BASE_F0)[0];
+    expect(phrase.segments.map((s) => s.ipa).join(" ")).toBe("o m o ɯ");
+  });
+  test("読みのない語は捨てる", () => {
+    expect(njdToItems([node("", "", 0, 0)])).toEqual([]);
+  });
+});
+
+describe("発話単位 → 句", () => {
+  const items = njdToItems([node("今日", "キョー", 1, 0), node("は", "ワ", 0, 1, "助詞"), node("。", "、", 0, 0, "記号"), node("元気", "ゲンキ", 1, 0), node("？", "？", 0, 0, "記号")]);
+  const phrases = itemsToPhrases(items, BASE_F0);
+  test("息継ぎごとに句が分かれ、語は口元の表示用に残る", () => {
+    expect(phrases.map((p) => p.words)).toEqual([["今日は"], ["元気"]]);
+    expect(phrases[0].segments.map((s) => s.ipa).join(" ")).toBe("k j o o w a");
+  });
+  test("疑問の句は最後が上がり、平叙の句は下がる", () => {
+    const lastF0 = (i: number) => phrases[i].segments.filter((s) => s.f0 !== undefined).at(-1)!.f0!;
+    expect(lastF0(1)).toBeGreaterThan(lastF0(0));
+  });
+  test("末尾に記号がなくても最後の句を落とさない", () => {
+    expect(itemsToPhrases(njdToItems([node("はい", "ハイ", 1, 0)]), BASE_F0)).toHaveLength(1);
+  });
+  test("息継ぎだけなら句を作らない", () => {
+    expect(itemsToPhrases([{ kind: "break", question: false }], BASE_F0)).toEqual([]);
+  });
+});
+
+describe("歌詞 → 音符ごとの音節", () => {
+  const sung = (text: string) => japaneseSyllables(text).map((s) => s.text);
+  test("かな 1 文字が 1 音符、拗音は 1 音符にまとまる", () => {
+    expect(sung("にしん きたか")).toEqual(["に", "しん", "き", "た", "か"]);
+    expect(sung("ちょい")).toEqual(["ちょ", "い"]);
+  });
+  test("「ー」は前の母音を次の音符へ伸ばす", () => {
+    const [so, hold] = japaneseSyllables("そー");
+    expect(hold).toMatchObject({ text: "ー", melisma: true, onset: [], nucleus: so.nucleus });
+  });
+  test("「ん」は音符を使わず、前の音節の終わりに付く", () => {
+    const syllables = japaneseSyllables("らん");
+    expect(syllables).toHaveLength(1);
+    expect(syllables[0].coda).toEqual([{ ipa: "ɴ" }]);
+  });
+  test("伸ばしたあとの「ん」は、伸ばした音符の終わりに付く", () => {
+    const syllables = japaneseSyllables("れーん");
+    expect(syllables.map((s) => s.coda.length)).toEqual([0, 1]);
+  });
+  test("「っ」は音符を使わない", () => {
+    expect(sung("どっこいしょ")).toEqual(["どっ", "こ", "い", "しょ"]);
+  });
+  test("歌詞では、お段 + う を勝手に伸ばさない", () => {
+    expect(sung("とう")).toEqual(["と", "う"]);
+  });
+  test("空白で語が、句読点で句が切れる", () => {
+    const syllables = japaneseSyllables("なみ に、きけ");
+    expect(syllables.map((s) => s.wordEnd)).toEqual([false, true, true, false, true]);
+    expect(syllables.map((s) => s.phraseEnd)).toEqual([false, false, true, false, true]);
+  });
+  test("かながなければ音節を作らない", () => {
+    expect(japaneseSyllables("  、 ")).toEqual([]);
+  });
+});
+
+describe("日本語の曲データ", () => {
+  test("どの曲も、音符の数と歌詞の音節の数が一致する", async () => {
+    const { JAPANESE_SONGS } = await import("../src/ui/songsJa.ts");
+    for (const song of JAPANESE_SONGS) expect([song.name, japaneseSyllables(song.lyrics).length]).toEqual([song.name, song.notes.length]);
+  });
+  test("「この道」は弱起 1.5 拍 + 9 小節 24 拍から、最後の休符 0.5 拍を除いた 25 拍になる", async () => {
+    const { JAPANESE_SONGS } = await import("../src/ui/songsJa.ts");
+    const song = JAPANESE_SONGS.find((s) => s.name === "この道")!;
+    expect(song.notes.reduce((sum, [, beats]) => sum + beats, 0)).toBe(25);
+  });
+  test("「この道」の息継ぎは、休符のある 5 か所と曲の終わりに入る", async () => {
+    const { JAPANESE_SONGS } = await import("../src/ui/songsJa.ts");
+    const song = JAPANESE_SONGS.find((s) => s.name === "この道")!;
+    const breaths = japaneseSyllables(song.lyrics).flatMap((s, i) => (s.phraseEnd ? [i + 1] : []));
+    expect(breaths).toEqual([5, 12, 14, 19, 26, 33]);
+  });
+});
diff --git a/tests/nepp-chat.test.ts b/tests/nepp-chat.test.ts
new file mode 100644
index 0000000..f9955f3
--- /dev/null
+++ b/tests/nepp-chat.test.ts
@@ -0,0 +1,152 @@
+import { describe, expect, test } from "bun:test";
+import { createDeltaParser, createSentenceSplitter, speechTextOf } from "../src/ui/neppChat.ts";
+import { SpeechQueue } from "../src/ui/speechQueue.ts";
+
+const delta = (text: string) => `data: ${JSON.stringify({ type: "text-delta", id: "m", delta: text })}\n\n`;
+
+describe("返答ストリームの読み取り", () => {
+  test("本文の差分だけを順に取り出す", () => {
+    const parse = createDeltaParser();
+    expect(parse(`data: {"type":"start"}\n\n${delta("こん")}${delta("にちは")}data: {"type":"finish"}\n\ndata: [DONE]\n\n`)).toEqual(["こん", "にちは"]);
+  });
+  test("行の途中で切れた断片は、続きが届いてから取り出す", () => {
+    const parse = createDeltaParser();
+    const line = delta("ねっぷ");
+    expect(parse(line.slice(0, 20))).toEqual([]);
+    expect(parse(line.slice(20))).toEqual(["ねっぷ"]);
+  });
+  test("壊れた行があっても、その後の差分は取り出せる", () => {
+    const parse = createDeltaParser();
+    expect(parse(`data: {oops\n${delta("よ")}`)).toEqual(["よ"]);
+  });
+  test("data 以外の行は無視する", () => {
+    const parse = createDeltaParser();
+    expect(parse(`event: ping\n: comment\n${delta("は")}`)).toEqual(["は"]);
+  });
+});
+
+describe("声に出す文面", () => {
+  test("Markdown の記号を落とす", () => {
+    expect(speechTextOf("**こんにちは** `ねっぷ`だよ")).toBe("こんにちは ねっぷだよ");
+  });
+  test("文の途中の絵文字と改行は息継ぎになり、文がつながらない", () => {
+    expect(speechTextOf("調べてくるね🌲✨音威子府村は")).toBe("調べてくるね、音威子府村は");
+    expect(speechTextOf("村だよ\n雪が多く")).toBe("村だよ。雪が多く");
+  });
+  test("先頭と末尾の絵文字は息継ぎを残さない", () => {
+    expect(speechTextOf("😊こんにちは🍜")).toBe("こんにちは");
+  });
+  test("リンクは表示名だけ残し、URL は読まない", () => {
+    expect(speechTextOf("[村のサイト](https://example.jp/a)を見てね https://example.jp/b")).toBe("村のサイトを見てね");
+  });
+  test("電話番号は区切りを「の」で読む", () => {
+    expect(speechTextOf("01656-5-3311")).toBe("01656の5の3311");
+  });
+  test("時刻は「時」「分」で読み、ちょうどの分は読まない", () => {
+    expect(speechTextOf("9:30")).toBe("9時30分");
+    expect(speechTextOf("10:00")).toBe("10時");
+  });
+  test("数字の前の波ダッシュは「から」と読む", () => {
+    expect(speechTextOf("9:00〜17:00")).toBe("9時から17時");
+  });
+  test("語尾の波ダッシュは伸ばす音にする", () => {
+    expect(speechTextOf("こんにちは〜！")).toBe("こんにちはー！");
+  });
+  test("掃除して何も残らなければ空文字を返す", () => {
+    expect(speechTextOf("😊 **")).toBe("");
+  });
+});
+
+describe("文ごとの切り出し", () => {
+  test("言い終わった文だけを返し、言いかけは次の差分まで持つ", () => {
+    const splitter = createSentenceSplitter();
+    expect(splitter.push("こんにちは！ねっぷ")).toEqual(["こんにちは！"]);
+    expect(splitter.push("ちゃんだよ。元気")).toEqual(["ねっぷちゃんだよ。"]);
+    expect(splitter.flush()).toBe("元気");
+  });
+  test("終わりの記号が末尾にあるうちは確定せず、続く記号をまとめる", () => {
+    const splitter = createSentenceSplitter();
+    expect(splitter.push("ほんと！")).toEqual([]);
+    expect(splitter.push("？すごい")).toEqual(["ほんと！？"]);
+  });
+  test("引用の中の感嘆符では分けない", () => {
+    const splitter = createSentenceSplitter();
+    expect(splitter.push("「食べてみたい！」ってなるものを調べるね。次")).toEqual(["「食べてみたい！」ってなるものを調べるね。"]);
+  });
+  test("改行でも文を分ける", () => {
+    const splitter = createSentenceSplitter();
+    expect(splitter.push("村だよ\n雪が多く")).toEqual(["村だよ"]);
+  });
+  test("小数点や時刻では分けない", () => {
+    const splitter = createSentenceSplitter();
+    expect(splitter.push("気温は3.5度、9:30に")).toEqual([]);
+  });
+  test("残りがなければ flush は null を返す", () => {
+    const splitter = createSentenceSplitter();
+    splitter.push("はい。");
+    expect(splitter.flush()).toBe("はい。");
+    expect(splitter.flush()).toBeNull();
+  });
+});
+
+describe("発話の順番待ち", () => {
+  const setup = (durations: Record<string, number | null>) => {
+    const log: string[] = [];
+    const waits: { seconds: number; resolve: () => void }[] = [];
+    const queue = new SpeechQueue(
+      async (text) => {
+        log.push(`speak:${text}`);
+        return text in durations ? durations[text] : 1;
+      },
+      () => log.push("stop"),
+      (seconds) => new Promise((resolve) => waits.push({ seconds, resolve })),
+    );
+    const settle = () => new Promise((resolve) => setTimeout(resolve, 0));
+    return { log, waits, queue, settle };
+  };
+
+  test("前の文が終わるまで次の文を喋り始めない", async () => {
+    const { log, waits, queue, settle } = setup({});
+    void queue.enqueue("一");
+    void queue.enqueue("二");
+    await settle();
+    expect(log).toEqual(["speak:一"]);
+    waits[0].resolve();
+    await settle();
+    expect(log).toEqual(["speak:一", "speak:二"]);
+  });
+  test("文の長さに間を足したぶんだけ待つ", async () => {
+    const { waits, queue, settle } = setup({ 一: 2 });
+    void queue.enqueue("一");
+    await settle();
+    expect(waits[0].seconds).toBeCloseTo(2.22, 6);
+  });
+  test("喋るものがない文は待たずに次へ進む", async () => {
+    const { log, waits, queue, settle } = setup({ 空: null });
+    void queue.enqueue("空");
+    void queue.enqueue("二");
+    await settle();
+    expect(log).toEqual(["speak:空", "speak:二"]);
+    expect(waits).toHaveLength(1);
+  });
+  test("clear は喋っている文を止め、待っていた文を捨てる", async () => {
+    const { log, waits, queue, settle } = setup({});
+    void queue.enqueue("一");
+    void queue.enqueue("二");
+    await settle();
+    queue.clear();
+    waits[0].resolve();
+    await settle();
+    expect(log).toEqual(["speak:一", "stop"]);
+  });
+  test("clear のあとに入れた文は喋る", async () => {
+    const { log, waits, queue, settle } = setup({});
+    void queue.enqueue("一");
+    await settle();
+    queue.clear();
+    void queue.enqueue("新");
+    waits[0].resolve();
+    await settle();
+    expect(log).toEqual(["speak:一", "stop", "speak:新"]);
+  });
+});
