diff --git a/src/ui/components/ChatPanel.tsx b/src/ui/components/ChatPanel.tsx
new file mode 100644
index 0000000..3c64942
--- /dev/null
+++ b/src/ui/components/ChatPanel.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useRef, useState } from "react";
+import { useStore } from "../store.ts";
+import { speakText, stopSpeaking } from "../speech.ts";
+import { NeppChat, speechTextOf } from "../neppChat.ts";
+import { SpeechQueue } from "../speechQueue.ts";
+import { Screen } from "./Screen.tsx";
+
+interface Message {
+  role: "user" | "nepp";
+  text: string;
+}
+
+const chat = new NeppChat();
+const SPEAKING_RATE = 1;
+
+/** ねっぷちゃんに話しかける欄。返ってきたセリフはそのまま声に出す */
+export function ChatScreen() {
+  const body = useStore((s) => s.body);
+  const f0 = useStore((s) => s.source.f0);
+  const start = useStore((s) => s.start);
+  const [messages, setMessages] = useState<Message[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const logRef = useRef<HTMLDivElement>(null);
+  const voice = useRef({ body, f0 });
+  voice.current = { body, f0 };
+  const queue = useRef<SpeechQueue | null>(null);
+  queue.current ??= new SpeechQueue(async (sentence) => {
+    const spoken = await speakText(sentence, { ipa: false, rate: SPEAKING_RATE, ...voice.current });
+    return spoken ? spoken.plan.end : null;
+  }, stopSpeaking);
+
+  useEffect(() => {
+    const log = logRef.current;
+    if (log) log.scrollTop = log.scrollHeight;
+  }, [messages]);
+
+  const submit = async () => {
+    const text = input.trim();
+    if (!text || busy) return;
+    setBusy(true);
+    setError(null);
+    setInput("");
+    setMessages((m) => [...m, { role: "user", text }, { role: "nepp", text: "" }]);
+    try {
+      // 返答を待ってから音を起こすと、クリックから時間が空いてブラウザに止められる
+      await start();
+      queue.current?.clear();
+      await chat.send(text, {
+        progress: (soFar) => setMessages((m) => [...m.slice(0, -1), { role: "nepp", text: soFar }]),
+        sentence: (sentence) => {
+          const spoken = speechTextOf(sentence);
+          if (spoken) void queue.current?.enqueue(spoken);
+        },
+      });
+    } catch (cause) {
+      console.error(cause);
+      setMessages((m) => (m.at(-1)?.text === "" ? m.slice(0, -1) : m));
+      setError("ねっぷちゃんにつながりませんでした。nepp-chan の API サーバー（localhost:8787）が起動しているか確認してください。");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <Screen className="s-chat" title="ねっぷちゃんと話す" sub="返事を声に出します">
+      <div className="chat">
+        <div className="chat-log" ref={logRef} aria-live="polite">
+          {messages.length === 0 && <p className="chat-empty">メッセージを送ると、ねっぷちゃんが返事をして、そのまま喋ります。</p>}
+          {messages.map((m, i) => (
+            <p key={i} className={`chat-msg ${m.role}`}>
+              {m.text || "…"}
+            </p>
+          ))}
+        </div>
+        {error && (
+          <p className="chat-error" role="alert">
+            {error}
+          </p>
+        )}
+        <form
+          className="chat-form"
+          onSubmit={(e) => {
+            e.preventDefault();
+            void submit();
+          }}
+        >
+          <input value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={(e) => e.stopPropagation()} placeholder="ねっぷちゃんに話しかける" aria-label="ねっぷちゃんへのメッセージ" />
+          <button className="primary" type="submit" disabled={busy || !input.trim()}>
+            {busy ? "返事を待っています…" : "送信"}
+          </button>
+        </form>
+      </div>
+    </Screen>
+  );
+}
