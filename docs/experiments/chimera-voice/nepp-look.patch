+++ b/src/ui/japanese.ts
@@ -0,0 +1,313 @@
+/**
+ * 日本語 → 発話計画の入力。モーラを等拍に並べ、アクセント核から各モーラの高さを決める。
+ * 入口は 2 つ: 手書きのかな記法（発音どおりのかな、' の直前のモーラがアクセント核、空白で
+ * アクセント句、句読点で息継ぎ）と、形態素解析（OpenJTalk）の結果。
+ */
+import type { Segment } from "../wasm/engine.ts";
+import type { Gesture, Syllable } from "../wasm/types.ts";
+
+const MORA_SEC = 0.14;
+const HIGH_RATIO = 1.12;
+const LOW_RATIO = 0.9;
+const DOWNSTEP_RATIO = 0.92;
+const DECLINATION = 0.08;
+const FINAL_FALL_RATIO = 0.9;
+const QUESTION_RISE_RATIO = 1.3;
+const F0_FLOOR_RATIO = 0.75;
+const FINAL_VOWEL_EXTRA_SEC = 0.06;
+const PHRASE_PAUSE_SEC = 0.35;
+
+const VOWEL_IPA: Record<string, string> = { a: "a", i: "i", u: "ɯ", e: "e", o: "o" };
+
+const ONSETS: Record<string, { ipa: string[]; dur: number }> = {
+  k: { ipa: ["k"], dur: 0.06 },
+  g: { ipa: ["g"], dur: 0.055 },
+  s: { ipa: ["s"], dur: 0.08 },
+  sh: { ipa: ["ʃ"], dur: 0.08 },
+  z: { ipa: ["z"], dur: 0.06 },
+  j: { ipa: ["dʒ"], dur: 0.07 },
+  t: { ipa: ["t"], dur: 0.06 },
+  ch: { ipa: ["tʃ"], dur: 0.075 },
+  ts: { ipa: ["ts"], dur: 0.075 },
+  d: { ipa: ["d"], dur: 0.05 },
+  n: { ipa: ["n"], dur: 0.05 },
+  ny: { ipa: ["ɲ"], dur: 0.05 },
+  h: { ipa: ["h"], dur: 0.06 },
+  hy: { ipa: ["ç"], dur: 0.07 },
+  f: { ipa: ["ɸ"], dur: 0.07 },
+  b: { ipa: ["b"], dur: 0.05 },
+  p: { ipa: ["p"], dur: 0.06 },
+  m: { ipa: ["m"], dur: 0.05 },
+  y: { ipa: ["j"], dur: 0.05 },
+  r: { ipa: ["ɾ"], dur: 0.03 },
+  w: { ipa: ["w"], dur: 0.05 },
+  ky: { ipa: ["k", "j"], dur: 0.08 },
+  gy: { ipa: ["g", "j"], dur: 0.075 },
+  by: { ipa: ["b", "j"], dur: 0.07 },
+  py: { ipa: ["p", "j"], dur: 0.08 },
+  my: { ipa: ["m", "j"], dur: 0.07 },
+  ry: { ipa: ["ɾ", "j"], dur: 0.06 },
+};
+
+const PALATALIZED: Record<string, string> = { k: "ky", g: "gy", s: "sh", sh: "sh", z: "j", j: "j", t: "ch", ch: "ch", d: "j", n: "ny", ny: "ny", h: "hy", hy: "hy", b: "by", p: "py", m: "my", r: "ry" };
+
+const NASAL_BEFORE: Record<string, string> = { p: "m", b: "m", m: "m", t: "n", d: "n", n: "n", ɲ: "ɲ", tʃ: "n", dʒ: "n", ts: "n", ɾ: "n", k: "ŋ", g: "ŋ" };
+
+const ROWS: [string, string][] = [
+  ["あいうえお", ""], ["かきくけこ", "k"], ["がぎぐげご", "g"], ["さしすせそ", "s"], ["ざじずぜぞ", "z"], ["たちつてと", "t"], ["だぢづでど", "d"],
+  ["なにぬねの", "n"], ["はひふへほ", "h"], ["ばびぶべぼ", "b"], ["ぱぴぷぺぽ", "p"], ["まみむめも", "m"], ["らりるれろ", "r"],
+];
+const IRREGULAR: Record<string, [string, string]> = {
+  し: ["sh", "i"], ち: ["ch", "i"], つ: ["ts", "u"], ふ: ["f", "u"], じ: ["j", "i"], ぢ: ["j", "i"], づ: ["z", "u"], ひ: ["hy", "i"], に: ["ny", "i"],
+  や: ["y", "a"], ゆ: ["y", "u"], よ: ["y", "o"], わ: ["w", "a"], を: ["", "o"],
+};
+const SMALL_Y: Record<string, string> = { ゃ: "a", ゅ: "u", ょ: "o" };
+const SMALL_VOWEL: Record<string, string> = { ぁ: "a", ぃ: "i", ぅ: "u", ぇ: "e", ぉ: "o" };
+const ACCENT_MARKS = new Set(["'", "’", "＼", "\\", "↓"]);
+
+const KANA = new Map<string, [string, string]>();
+for (const [chars, onset] of ROWS) [...chars].forEach((ch, i) => KANA.set(ch, [onset, "aiueo"[i]]));
+for (const [ch, cv] of Object.entries(IRREGULAR)) KANA.set(ch, cv);
+
+/** text は入力に書かれていたかな（歌詞の表示に使う） */
+export type Mora = { kind: "cv"; onset: string; vowel: string; text: string } | { kind: "N" } | { kind: "Q" } | { kind: "R" };
+
+export const containsKana = (text: string): boolean => /[ぁ-ゖァ-ヺ]/.test(text);
+
+const toHiragana = (ch: string): string => (ch >= "ァ" && ch <= "ヶ" ? String.fromCharCode(ch.charCodeAt(0) - 0x60) : ch);
+
+/** アクセント句 1 つぶんのかなをモーラ列にする。accent は核のモーラ番号（0 = 平板） */
+export function parseAccentPhrase(text: string, o: { lengthenOU?: boolean } = {}): { moras: Mora[]; accent: number } {
+  const lengthenOU = o.lengthenOU ?? true;
+  const moras: Mora[] = [];
+  let accent = 0;
+  for (const raw of text) {
+    const ch = toHiragana(raw);
+    const prev = moras.at(-1);
+    if (ACCENT_MARKS.has(ch)) accent = moras.length;
+    else if (ch === "ん") moras.push({ kind: "N" });
+    else if (ch === "っ") moras.push({ kind: "Q" });
+    else if (ch === "ー") moras.push({ kind: "R" });
+    else if (SMALL_Y[ch] && prev?.kind === "cv") {
+      prev.onset = PALATALIZED[prev.onset] ?? prev.onset;
+      prev.vowel = SMALL_Y[ch];
+      prev.text += raw;
+    } else if (SMALL_VOWEL[ch] && prev?.kind === "cv") {
+      prev.vowel = SMALL_VOWEL[ch];
+      prev.text += raw;
+    }
+    else if (lengthenOU && ch === "う" && prev?.kind === "cv" && prev.vowel === "o") moras.push({ kind: "R" });
+    else {
+      const cv = KANA.get(ch);
+      if (cv) moras.push({ kind: "cv", onset: cv[0], vowel: cv[1], text: raw });
+    }
+  }
+  return { moras, accent };
+}
+
+function moraLevels(count: number, accent: number): ("H" | "L")[] {
+  return Array.from({ length: count }, (_, i) => {
+    const n = i + 1;
+    if (accent === 0) return n === 1 ? "L" : "H";
+    if (accent === 1) return n === 1 ? "H" : "L";
+    return n === 1 || n > accent ? "L" : "H";
+  });
+}
+
+function moraSegments(mora: Mora, prevVowel: string | undefined, next: Mora | undefined): Segment[] {
+  if (mora.kind === "Q") return [];
+  if (mora.kind === "R") return prevVowel ? [{ ipa: prevVowel, dur: MORA_SEC }] : [];
+  if (mora.kind === "N") {
+    const nextOnset = next?.kind === "cv" ? ONSETS[next.onset]?.ipa[0] : undefined;
+    return [{ ipa: (nextOnset && NASAL_BEFORE[nextOnset]) || "ɴ", dur: MORA_SEC }];
+  }
+  const onset = ONSETS[mora.onset];
+  const onsetSegments = onset ? onset.ipa.map((ipa) => ({ ipa, dur: onset.dur / onset.ipa.length })) : [];
+  return [...onsetSegments, { ipa: VOWEL_IPA[mora.vowel], dur: MORA_SEC - (onset?.dur ?? 0) }];
+}
+
+function planBreathGroup(parsed: { moras: Mora[]; accent: number }[], baseF0: number, question: boolean): Segment[] {
+  const totalMoras = parsed.reduce((sum, p) => sum + p.moras.length, 0);
+  const segments: Segment[] = [];
+  let register = 1;
+  let moraIndex = 0;
+  for (const { moras, accent } of parsed) {
+    const levels = moraLevels(moras.length, accent);
+    let geminate = false;
+    moras.forEach((mora, i) => {
+      const prevVowel = segments.at(-1)?.ipa;
+      const segs = moraSegments(mora, prevVowel, moras[i + 1]);
+      const isLast = moraIndex === totalMoras - 1;
+      const declination = 1 - DECLINATION * (moraIndex / Math.max(1, totalMoras - 1));
+      const ending = isLast ? (question ? QUESTION_RISE_RATIO : FINAL_FALL_RATIO) : 1;
+      const ratio = (levels[i] === "H" ? HIGH_RATIO : LOW_RATIO) * register * declination * ending;
+      const carrier = segs.at(-1);
+      if (carrier) carrier.f0 = Math.round(baseF0 * Math.max(F0_FLOOR_RATIO, ratio));
+      if (geminate && segs[0]) {
+        segs[0].dur = (segs[0].dur ?? 0) + MORA_SEC;
+        geminate = false;
+      }
+      if (mora.kind === "Q") geminate = true;
+      segments.push(...segs);
+      moraIndex += 1;
+    });
+    const last = segments.at(-1);
+    if (last) last.wordEnd = true;
+    if (accent > 0) register *= DOWNSTEP_RATIO;
+  }
+  const finalVowel = segments.at(-1);
+  if (finalVowel?.dur !== undefined) finalVowel.dur += FINAL_VOWEL_EXTRA_SEC;
+  return segments;
+}
+
+export interface JapanesePhrase {
+  segments: Segment[];
+  intonation: "flat";
+  pause: number;
+  words: string[];
+}
+
+export function japanesePhrases(text: string, baseF0: number): JapanesePhrase[] {
+  const groups = text.match(/[^、。，．,.!?！？\n|/]+[、。，．,.!?！？]?/g) ?? [];
+  return groups
+    .map((group) => {
+      const question = /[?？]$/.test(group);
+      const accentPhrases = group.replace(/[、。，．,.!?！？]$/, "").split(/[\s　]+/).filter((p) => parseAccentPhrase(p).moras.length > 0);
+      const words = accentPhrases.map((p) => [...p].filter((ch) => !ACCENT_MARKS.has(ch)).join(""));
+      return { segments: planBreathGroup(accentPhrases.map((p) => parseAccentPhrase(p)), baseF0, question), intonation: "flat" as const, pause: PHRASE_PAUSE_SEC, words };
+    })
+    .filter((p) => p.segments.length > 0);
+}
+
+/** 形態素解析（OpenJTalk の NJD）が 1 語ごとに返す項目のうち、ここで使うもの */
+export interface NjdNode {
+  string: string;
+  pron: string;
+  pos: string;
+  /** アクセント句の先頭の語では、句全体で数えた核のモーラ番号（0 = 平板） */
+  acc: number;
+  /** 1 = 前の語と同じアクセント句に続く */
+  chain_flag: number;
+}
+
+export type SpeechItem = { kind: "unit"; text: string; moras: Mora[]; accent: number } | { kind: "break"; question: boolean };
+
+/** 解析器が読めない、または読みを固定したい語（手書きのかな記法で書く） */
+const PROPER_READINGS: Record<string, string> = {
+  ねっぷちゃん: "ね'っぷちゃん",
+  おといねっぷ: "おといねっぷ",
+  ねっぷ: "ね'っぷ",
+  咲来: "さっくる",
+  筬島: "おさしま",
+  物満内: "ものまない",
+  天北: "てんぽく",
+  木遊館: "もくゆーかん",
+};
+const PROPER_RE = new RegExp(`(${Object.keys(PROPER_READINGS).sort((a, b) => b.length - a.length).join("|")})`);
+
+export const containsJapanese = (text: string): boolean => containsKana(text) || /[\u4e00-\u9fff]/.test(text);
+
+/** 手書き記法として読むのは、アクセント記号があって漢字がない入力だけ */
+export const isKanaNotation = (text: string): boolean => /['’＼\\↓]/.test(text) && !/[\u4e00-\u9fff]/.test(text);
+
+/** 固有語とそれ以外に分ける。固有語は解析器に渡さず、決めた読みを使う */
+export function splitProperNouns(text: string): { text: string; reading?: string }[] {
+  return text
+    .split(PROPER_RE)
+    .filter((part) => part !== "")
+    .map((part) => (PROPER_READINGS[part] ? { text: part, reading: PROPER_READINGS[part] } : { text: part }));
+}
+
+export function properNounItem(text: string, reading: string): SpeechItem {
+  return { kind: "unit", text, ...parseAccentPhrase(reading) };
+}
+
+// 解析器は無声化する母音の後ろに ’ を付ける。無声化は扱わないので落とす
+const DEVOICING_MARK = /’/g;
+
+export function njdToItems(nodes: NjdNode[]): SpeechItem[] {
+  const items: SpeechItem[] = [];
+  for (const node of nodes) {
+    if (node.pos === "記号") {
+      items.push({ kind: "break", question: /[?？]/.test(node.string) });
+      continue;
+    }
+    const moras = parseAccentPhrase(node.pron.replace(DEVOICING_MARK, ""), { lengthenOU: false }).moras;
+    if (moras.length === 0) continue;
+    const prev = items.at(-1);
+    if (node.chain_flag === 1 && prev?.kind === "unit") {
+      prev.moras.push(...moras);
+      prev.text += node.string;
+    } else items.push({ kind: "unit", text: node.string, moras, accent: node.acc });
+  }
+  return items;
+}
+
+export function itemsToPhrases(items: SpeechItem[], baseF0: number): JapanesePhrase[] {
+  const phrases: JapanesePhrase[] = [];
+  let units: Extract<SpeechItem, { kind: "unit" }>[] = [];
+  const flush = (question: boolean) => {
+    if (units.length > 0) phrases.push({ segments: planBreathGroup(units, baseF0, question), intonation: "flat", pause: PHRASE_PAUSE_SEC, words: units.map((u) => u.text) });
+    units = [];
+  };
+  for (const item of items) {
+    if (item.kind === "unit") units.push(item);
+    else flush(item.question);
+  }
+  flush(false);
+  return phrases;
+}
+
+/**
+ * 歌詞のかな → 音符 1 つぶんずつの音節。かな 1 文字（拗音はまとめて）が 1 音符を使い、「ー」は
+ * 前の母音を次の音符へ伸ばす。「ん」は前の音符の終わりに付き、「っ」は音符を使わない。
+ * 空白で語、句読点と / で句が切れる。
+ */
+export function japaneseSyllables(text: string): Syllable[] {
+  const out: Syllable[] = [];
+  for (const phrase of text.split(/[、。，．,.!?！？\n|/]+/)) {
+    for (const word of phrase.split(/[\s　]+/)) {
+      const { moras } = parseAccentPhrase(word, { lengthenOU: false });
+      let sang = false;
+      moras.forEach((mora, i) => {
+        const prev = out.at(-1);
+        if (mora.kind === "cv") {
+          out.push({ text: mora.text, onset: (ONSETS[mora.onset]?.ipa ?? []).map((ipa) => ({ ipa })), nucleus: { ipa: VOWEL_IPA[mora.vowel] }, coda: [], wordEnd: false, phraseEnd: false });
+          sang = true;
+        } else if (!prev) return;
+        else if (mora.kind === "R") {
+          out.push({ text: "ー", onset: [], nucleus: { ...prev.nucleus }, coda: [], melisma: true, wordEnd: false, phraseEnd: false });
+          sang = true;
+        } else if (mora.kind === "N") {
+          const next = moras[i + 1];
+          const nextOnset = next?.kind === "cv" ? ONSETS[next.onset]?.ipa[0] : undefined;
+          prev.coda.push({ ipa: (nextOnset && NASAL_BEFORE[nextOnset]) || "ɴ" });
+          prev.text += "ん";
+        } else prev.text += "っ";
+      });
+      const last = out.at(-1);
+      if (sang && last) last.wordEnd = true;
+    }
+    const last = out.at(-1);
+    if (last) last.phraseEnd = true;
+  }
+  return out;
+}
+
+const ASPIRATED_ABDUCTION = 0.36;
+const UNASPIRATED_ABDUCTION = 0.22;
+const ASPIRATED_VOT = 0.05;
+const UNASPIRATED_VOT = 0.012;
+const FRICATIVE_LEAD = 0.015;
+
+/**
+ * プランナーは母音前の無声破裂音を英語式に帯気させ、摩擦音では声門を早めに開く。日本語の短い
+ * 母音が無声のまま終わるので、帯気を無気の形に戻し、摩擦音の前倒しをやめる。
+ */
+export function adaptVoicingForJapanese(gestures: Gesture[], rate: number): Gesture[] {
+  return gestures.map((g) => {
+    if (g.label === "voiceless") return { ...g, t0: g.t0 + FRICATIVE_LEAD, rampIn: 0.02 };
+    if (g.label !== "aspiration" || g.targets.abduction !== ASPIRATED_ABDUCTION) return g;
+    return { ...g, t1: g.t1 + (UNASPIRATED_VOT - ASPIRATED_VOT / rate) * 0.4, rampOut: 0.02, targets: { ...g.targets, abduction: UNASPIRATED_ABDUCTION } };
+  });
+}
