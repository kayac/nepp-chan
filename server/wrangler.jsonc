/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "51544998e04526c4d6cc9e3e08653361",
  "name": "nepp-chan-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "alias": {
    "~": "./src"
  },
  "placement": { "mode": "smart" },
  "triggers": {
    "crons": ["*/5 * * * *", "0 18 * * *", "0 20 * * 1"]
  },
  "env": {
    "local": {
      "name": "nepp-chan-server-local",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nepp-chan-db-dev",
          "database_id": "bd4f1aee-768d-4273-ab72-5aef42f1c199",
          "migrations_dir": "./src/db/migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "nepp-chan-knowledge-local",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "KNOWLEDGE_BUCKET",
          "bucket_name": "nepp-chan-knowledge-local",
          "remote": true
        },
        {
          "binding": "LINE_BROADCAST_BUCKET",
          "bucket_name": "nepp-chan-broadcast-dev",
          "remote": true
        }
      ],
      "queues": {
        "producers": [
          { "binding": "LINE_QUEUE", "queue": "nepp-chan-line-queue-local" }
        ],
        "consumers": [
          {
            "queue": "nepp-chan-knowledge-sync-local",
            "max_batch_size": 10,
            "max_batch_timeout": 30
          },
          {
            "queue": "nepp-chan-line-queue-local",
            "max_batch_size": 1,
            "max_batch_timeout": 0
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "local",
        "WEB_URL": "http://localhost:5173",
        "LP_URL": "http://localhost:5174"
      }
    },
    "development": {
      "name": "nepp-chan-server-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nepp-chan-db-dev",
          "database_id": "bd4f1aee-768d-4273-ab72-5aef42f1c199",
          "migrations_dir": "./src/db/migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "nepp-chan-knowledge-dev",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "KNOWLEDGE_BUCKET",
          "bucket_name": "nepp-chan-knowledge-dev"
        },
        {
          "binding": "LINE_BROADCAST_BUCKET",
          "bucket_name": "nepp-chan-broadcast-dev"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "LINE_QUEUE", "queue": "nepp-chan-line-queue-dev" }
        ],
        "consumers": [
          {
            "queue": "nepp-chan-knowledge-sync-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 30
          },
          {
            "queue": "nepp-chan-line-queue-dev",
            "max_batch_size": 1,
            "max_batch_timeout": 0
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "development",
        "WEB_URL": "https://dev-web.nepp-chan.ai",
        "LP_URL": "https://dev.nepp-chan.ai"
      }
    },
    "production": {
      "name": "nepp-chan-server-prd",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nepp-chan-db-prd",
          "database_id": "239abba6-e30a-4628-97fc-20bf49ca8404",
          "migrations_dir": "./src/db/migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "nepp-chan-knowledge-prd"
        }
      ],
      "r2_buckets": [
        {
          "binding": "KNOWLEDGE_BUCKET",
          "bucket_name": "nepp-chan-knowledge-prd"
        },
        {
          "binding": "LINE_BROADCAST_BUCKET",
          "bucket_name": "nepp-chan-broadcast-prd"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "LINE_QUEUE", "queue": "nepp-chan-line-queue-prd" }
        ],
        "consumers": [
          {
            "queue": "nepp-chan-knowledge-sync-prd",
            "max_batch_size": 10,
            "max_batch_timeout": 30
          },
          {
            "queue": "nepp-chan-line-queue-prd",
            "max_batch_size": 1,
            "max_batch_timeout": 0
          }
        ]
      },
      "vars": {
        "ENVIRONMENT": "production",
        "WEB_URL": "https://web.nepp-chan.ai",
        "LP_URL": "https://nepp-chan.ai"
      }
    }
  }
}
