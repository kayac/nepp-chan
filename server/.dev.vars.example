GOOGLE_GENERATIVE_AI_API_KEY=your-api-key-here
GOOGLE_SEARCH_ENGINE_ID=your-engine-id-here

# JWT
JWT_SECRET=local-dev-jwt-secret-must-be-at-least-32-chars-long

# LINE userId のハッシュ化用シークレット（HMAC-SHA256 のキー）
RESOURCE_ID_HASH_SECRET=local-dev-resource-id-hash-secret-change-me

# Eval専用（省略時は GOOGLE_GENERATIVE_AI_API_KEY を使用）
EVAL_GOOGLE_API_KEY=

# OpenAI（Evalスコアラー用: gpt-5-nano）
OPENAI_API_KEY=

# LINE Messaging API
LINE_CHANNEL_SECRET=your-channel-secret-here
LINE_CHANNEL_ACCESS_TOKEN=your-chan=======

# Sentry
SENTRY_DSN=

# Twilio ConversationRelay（通話機能）
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# webhook 署名検証（X-Twilio-Signature）用 Auth Token
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# relay WS 入場用の短命トークン署名鍵（HMAC-SHA256）
CALL_TOKEN_SECRET=local-dev-call-token-secret-change-me
