{
  "name": "@nepp-chan/server",
  "version": "1.0.14",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy --minify --env development",
    "deploy:prd": "wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env development",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply nepp-chan-db-dev --remote --env development",
    "db:migrate:prd": "wrangler d1 migrations apply nepp-chan-db-prd --remote --env production",
    "db:migrate:local": "wrangler d1 migrations apply nepp-chan-db-dev --local --env local && wrangler d1 execute nepp-chan-db-dev --local --env local --file scripts/seed-local-admin.sql",
    "db:seed:local": "wrangler d1 execute nepp-chan-db-dev --local --env local --file scripts/seed-local.sql",
    "db:check": "drizzle-kit check",
    "eval:v2": "tsx scripts/run-eval-v2.ts",
    "eval:v3": "tsx scripts/run-eval-v3.ts",
    "eval:neppchan": "tsx src/mastra/evals/neppchan/run.ts",
    "eval:neppchan:snapshot": "tsx src/mastra/evals/neppchan/snapshot.ts",
    "eval:neppchan:vitest": "vitest run --config vitest.eval.config.ts",
    "api:quota": "tsx scripts/api-quota.ts",
    "elevenlabs:setup": "tsx scripts/elevenlabs-setup.ts",
    "elevenlabs:push-prompt": "tsx scripts/elevenlabs-push-prompt.ts",
    "knowledge:date-ranking": "tsx scripts/knowledge-date-ranking.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai": "^4.0.106",
    "@ai-sdk/typesafe-ai": "^3.0.33",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@line/bot-sdk": "^11.4.0",
    "@mastra/ai-sdk": "^1.11.3",
    "@mastra/cloudflare-d1": "1.5.0",
    "@mastra/core": "1.81.0",
    "@mastra/evals": "1.10.10",
    "@mastra/libsql": "1.28.0",
    "@mastra/loggers": "1.3.10",
    "@mastra/mcp": "2.7.0",
    "@mastra/memory": "1.40.0",
    "@mastra/observability": "1.23.0",
    "@mastra/rag": "2.7.1",
    "@nepp-chan/shared": "workspace:*",
    "@sentry/cloudflare": "^11.10.0",
    "ai": "^7.0.159",
    "drizzle-orm": "^0.45.4",
    "glob": "^14.0.4",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.76.0",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "~5.0.5",
    "drizzle-kit": "^0.31.11",
    "mastra": "1.37.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "~5.0.5",
    "wrangler": "^4.159.0"
  }
}
