{
  "name": "@nepp-chan/server",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy --minify --env development",
    "deploy:prd": "wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env development",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply nepp-chan-db-dev --remote --env development",
    "db:migrate:prd": "wrangler d1 migrations apply nepp-chan-db-prd --remote --env production",
    "db:migrate:local": "wrangler d1 migrations apply nepp-chan-db-dev --local --env local",
    "db:studio": "drizzle-kit studio",
    "db:studio:dev": "D1_ENV=dev drizzle-kit studio",
    "db:studio:prd": "D1_ENV=prd drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "eval:v2": "tsx scripts/run-eval-v2.ts",
    "eval:v3": "tsx scripts/run-eval-v3.ts",
    "api:quota": "tsx scripts/api-quota.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@line/bot-sdk": "^11.0.1",
    "@mastra/ai-sdk": "^1.4.4",
    "@mastra/cloudflare-d1": "1.0.4",
    "@mastra/core": "1.10.0",
    "@mastra/evals": "1.2.4",
    "@mastra/libsql": "1.9.0",
    "@mastra/loggers": "1.1.2",
    "@mastra/mcp": "1.9.1",
    "@mastra/memory": "1.20.2",
    "@mastra/observability": "1.4.0",
    "@mastra/rag": "2.2.1",
    "@nepp-chan/shared": "workspace:*",
    "@sentry/cloudflare": "^10.56.0",
    "ai": "^6.0.198",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.3",
    "@types/node": "^25.9.2",
    "@vitest/coverage-istanbul": "~4.1.8",
    "drizzle-kit": "^0.31.10",
    "mastra": "1.10.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "~4.1.8",
    "wrangler": "^4.98.0"
  }
}
