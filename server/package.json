{
  "name": "@nepp-chan/server",
  "version": "1.0.11",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy --minify --env development",
    "deploy:prd": "wrangler deploy --minify --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings --env development",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "mastra:start": "mastra start",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply nepp-chan-db-dev --remote --env development",
    "db:migrate:prd": "wrangler d1 migrations apply nepp-chan-db-prd --remote --env production",
    "db:migrate:local": "wrangler d1 migrations apply nepp-chan-db-dev --local --env local",
    "db:seed:local": "wrangler d1 execute nepp-chan-db-dev --local --env local --file scripts/seed-local.sql",
    "db:check": "drizzle-kit check",
    "eval:v2": "tsx scripts/run-eval-v2.ts",
    "eval:v3": "tsx scripts/run-eval-v3.ts",
    "api:quota": "tsx scripts/api-quota.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/openai": "^3.0.73",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@line/bot-sdk": "^11.2.0",
    "@mastra/ai-sdk": "^1.6.2",
    "@mastra/cloudflare-d1": "1.1.1",
    "@mastra/core": "1.52.1",
    "@mastra/evals": "1.6.0",
    "@mastra/libsql": "1.17.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/mcp": "1.16.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "1.16.2",
    "@mastra/rag": "2.4.2",
    "@nepp-chan/shared": "workspace:*",
    "@sentry/cloudflare": "^10.70.0",
    "ai": "^6.0.208",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "~4.1.10",
    "drizzle-kit": "^0.31.10",
    "mastra": "1.20.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "~4.1.10",
    "wrangler": "^4.123.0"
  }
}
