{
  "name": "@nepp-chan/widget",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.iframe.config.ts",
    "build": "pnpm build:iframe && pnpm build:loader",
    "build:iframe": "vite build --config vite.iframe.config.ts",
    "build:loader": "vite build --config vite.loader.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.105",
    "@heroicons/react": "^2.2.0",
    "@nepp-chan/shared": "workspace:*",
    "ai": "^7.0.102",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "~5.0.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "~5.0.1"
  }
}
