{
  "name": "@nepp-chan/shared",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles/*": "./src/styles/*",
    "./ui/*": "./src/ui/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./api": "./src/api/index.ts",
    "./api/repository/*": "./src/api/repository/*.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./constants/*": "./src/constants/*.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.210",
    "@radix-ui/react-slot": "^1.3.0",
    "ai": "^6.0.208",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "openapi-fetch": "^0.17.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "~4.1.9",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "typescript": "~6.0.3",
    "vitest": "~4.1.9"
  }
}
