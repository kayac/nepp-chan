{
  "name": "@nepp-chan/lp",
  "private": true,
  "version": "1.0.14",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm --filter @nepp-chan/widget build && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "deploy": "PUBLIC_ENV=dev VITE_ENV=dev pnpm build && wrangler pages deploy --project-name nepp-chan-lp-dev --branch develop",
    "deploy:prd": "PUBLIC_ENV=prd VITE_ENV=prd pnpm build && wrangler pages deploy --project-name nepp-chan-lp-prd --branch main"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.105",
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.6",
    "@heroicons/react": "^2.2.0",
    "@nepp-chan/shared": "workspace:*",
    "ai": "^7.0.109",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "^4.136.1"
  }
}
