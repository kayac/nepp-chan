---
// 法務文書（プライバシーポリシー・利用規約）用レイアウト。
// src/pages/*.md の `layout` frontmatter から参照され、Markdown を静的 HTML ページとして描画する。
import Layout from "~/layouts/Layout.astro";

type Props = {
  frontmatter: {
    title: string;
    description?: string;
  };
};

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ねっぷちゃん`}
  description={frontmatter.description}
  bodyClass="bg-(--color-bg) text-(--color-text)"
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <article class="legal-prose flex flex-col gap-4 text-sm">
      <slot />
    </article>
  </main>
</Layout>

<style>
  /* slot に流し込まれる Markdown 生成要素はスコープ class が付かないため :global で当てる */
  .legal-prose :global(h2) {
    margin-top: 1.5rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .legal-prose :global(h3) {
    margin-top: 1rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .legal-prose :global(p) {
    line-height: 1.9;
  }
  .legal-prose :global(ul) {
    padding-left: 1.5rem;
    list-style: disc;
  }
  .legal-prose :global(ol) {
    padding-left: 1.5rem;
    list-style: decimal;
  }
  .legal-prose :global(a) {
    color: var(--brand, #0f766e);
    text-decoration: underline;
  }
</style>
